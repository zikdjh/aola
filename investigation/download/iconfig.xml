<?xml version="1.0" ?>
<!-- res标签的根目录强制为\asset\baricons\ -->
<!--
  如下为icon标签下的例子
  属性解释：
  isMiddleXY默认是true,需要手动设置为false，
  取消默认的水平锤子居中。用于需要手动调整hud位置的。
  在hud添加到舞台后，你可以调整相对位置来实现hud的位置，而不用担心由于水平居中带来的实际大小变化再居中的影响）
  isFromLetTop是表示这个hud从别的数据源中查找数据。而不是当前的配置。当前的配置只是一个key。这个是为了解决。lefTop上的带subhud的，如果leftTop上有了，就不需要再弄一份了。所以直接拷贝他的数据。（目前这个数据只有huiguiwanjia有效
  如果想添加，修改：IconConfigReader.as
  ）
  <icon key="icon1" priority="1" row="1" debug="false" addFundus="true", isMiddleXY="false" isFromLetTop="true">
    <res>activityicon5_18</res>
    <clsName>mmo.baricons.Activity5_18Icon</clsName>
    <condition>
      <server>0</server>//0表示无条件要求，1表示旧服，2表示新服
      <task id="150" auto="true"></task>//id=-1表示无条件
      <event>showiconmustevent</event>        //showiconmustevent训练师等级小于6时,hud不显示 <event>showiconmustevent</event>默认是这个，不配的话会在训练师流程显示
      <date start="05/26/2017 00:01" end="05/30/2017 23:57"/> //2017.5.26到2017.5.30出现，其他时间不会出现
      <life value="21" type="GE"></life>//value表示星龄 type="G"表示星龄大于value才出现 type="L"表示星龄小于value才出现 E表示等于时也出现(可以和L和G组合 例如LE GE)
      <battleEff>0</battleEff>,开放（可见）hud的战斗力限制，没有的话，可以不用设置，战斗力过滤优先级很低，taskId的过滤优先级最高
      <newtaskid>0</newtaskid> //新手副本的解锁条件  与战力是或的关系  原task的字段弃用
	  <notifyId>后端给的id。来自HudControlClient</notifyId>//某些奖励领取后就消失hud的可以用这个
    </condition>
	<labelFrame>图标要显示哪个标签。参照HudIconBase.FRAME_XX</labelFrame>工具：产品Excel和HUD排序2022.py如果有配置的话，则会自动注入，
    <tips deltaX="45" deltaY="-5">创建测试例子</tips>
  </icon>
  注意：
  1.mmo.baricons.Activity5_18Icon必须为显示对象或实现IInitService接口
  2.condition标签下两个子标签只选其一，task优先至尊
  3.deltaX和deltaY属性为tips偏移量，在IIconService未修改前没效
  4.priority越小，图标就越靠近中间。同侧icon的priority不能相同
-->
